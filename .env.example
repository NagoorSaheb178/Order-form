# ==========================================
# Restaurant Ordering System Configuration
# ==========================================

# MongoDB Connection String (Required for saving & tracking orders)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurant_orders?appName=Cluster0

# Kitchen AI Integration Webhooks
KITCHEN_ORDER_WEBHOOK_URL=http://localhost:3001/api/webhooks/orders
KITCHEN_STATUS_WEBHOOK_SECRET=your_kitchen_status_webhook_secret_here
